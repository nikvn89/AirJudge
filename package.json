{
  "name": "airjudge",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-source.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "python3 -m pytest tests/ -q",
    "test:frontend": "node --experimental-strip-types --test tests/frontend/*.test.mjs",
    "verify": "python3 -m genvm_linter.cli lint contracts/airjudge.py && python3 -m pytest tests/ -q && npm run test:frontend && npm run build",
    "check:deployment": "node --experimental-strip-types scripts/check-deployment.mjs"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.54"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
